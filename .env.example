# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Found in your Supabase project settings under API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Found in your Supabase project settings under API.
VITE_SUPABASE_ANON_KEY="your-anon-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LinkedIn OAuth Credentials
# Obtain from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Hunter.io API
# Obtain from: https://hunter.io/api
VITE_HUNTER_API_KEY=
