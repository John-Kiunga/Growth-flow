rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'jkyunger@gmail.com' && request.auth.token.email_verified == true;
    }

    // Leads collection
    match /leads/{leadId} {
      allow read, write: if isAdmin() && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
      
      // Specifically ensure list queries are also restricted
      allow list: if isAdmin();
    }
  }
}
